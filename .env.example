# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy these values into your `.env` file or set them in your deployment platform.
# For Vercel deployments, set these as Environment Variables under Project Settings.
# ==============================================================================

# NODE_ENV: Set the environment mode of the application.
# Allowed values:
# - development : Default mode, enables debug logs, unsecure defaults, and local testing.
# - production  : Production mode, enforces strict security checks, HTTPS/CORS restrictions, and secure passwords.
NODE_ENV="development"

# PORT: The port number the backend server will bind to.
# Default is 3000.
PORT=3000

# ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS protection.
# e.g., "https://dhruv-portfolio.vercel.app,https://dhruv-portfolio-git-main.vercel.app"
# Leave empty to allow any origin in development, but must be configured for secure production deployment.
ALLOWED_ORIGINS=""

# JWT_SECRET: A strong, unique, and randomly generated secret key for signing admin login tokens.
# Must be configured in production (minimum 8 characters, recommended 32+ characters).
# e.g., "7f8b9c2a1d4e6f0b3c5a7e9d8f0a2b4c"
JWT_SECRET=""

# ADMIN_PASSWORD: Secure passcode for logging into the admin management dashboard.
# Must be changed from the default "Dhruv@592003" when deploying to production.
ADMIN_PASSWORD=""

# MONGODB_URI: Connection string for MongoDB.
# Optional. If not set, the server falls back to a persistent JSON-file-based local database.
MONGODB_URI=""

# ==============================================================================
# EMAIL SERVICE CONFIGURATION (Optional - for contact form inquiries forwarding)
# ==============================================================================

# CONTACT_RECEIVER_EMAIL: The email address where contact form notifications will be delivered.
CONTACT_RECEIVER_EMAIL="cocdhruv4444@gmail.com"

# SMTP_HOST: SMTP server host for sending email notifications (e.g., smtp.gmail.com).
SMTP_HOST=""

# SMTP_PORT: SMTP port (typically 587 or 465).
SMTP_PORT="587"

# SMTP_USER: SMTP authentication username or email.
SMTP_USER=""

# SMTP_PASS: SMTP authentication app password or security key.
SMTP_PASS=""

# ==============================================================================
# PLATFORM INJECTED VARIABLES (Injected automatically by Google AI Studio)
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI assistant.
# Configured via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and endpoint resolutions.
APP_URL="MY_APP_URL"
